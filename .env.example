# ==============================================================================
# Hope UltraLight Environment Configuration
# ==============================================================================

# --- Telegram Bot Interface (Required) ---
# 1. Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# 2. Get your numeric User ID from @userinfobot (Locks bot exclusively to you)
ALLOWED_TELEGRAM_USER_ID=123456789

# --- Tier 1: Local Brain (Ollama - Private & Edge Native) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_DEEP_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=60

# --- Tier 2: Free Cloud Workhorse (OpenRouter) ---
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=thinkingmachines/inkling-2-small:free
DAILY_OPENROUTER_LIMIT=200

# --- Tier 3: Cloud Fallback & Audio (Google Gemini) ---
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash
DAILY_GEMINI_LIMIT=50

# --- Optional Integrations ---
# GitHub Fine-Grained Token (https://github.com/settings/tokens?type=beta)
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=

# Google Workspace (OAuth via credentials.json & token.json)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Core Security & Operating Settings ---
REQUIRE_APPROVAL=true
APPROVAL_EXPIRY_MINUTES=30
TIMEZONE=Asia/Kolkata
DATABASE_PATH=workspace/hope.db
RESPONSE_CACHE_HOURS=4